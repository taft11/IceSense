rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isOwner(ownerId) {
      return isSignedIn() && request.auth.uid == ownerId;
    }

    function isAdminOrOwner(ownerId) {
      return isAdmin() || isOwner(ownerId);
    }

    match /orders/{orderId} {
      allow read: if isAdminOrOwner(resource.data.userId);

      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasAll(['userId', 'items', 'total', 'status', 'createdAt', 'customerName', 'customerEmail'])
        && request.resource.data.userId is string
        && request.resource.data.items is list
        && request.resource.data.total is number
        && request.resource.data.status is string
        && request.resource.data.createdAt is timestamp
        && request.resource.data.customerName is string
        && request.resource.data.customerEmail is string;

      allow update, delete: if isAdmin() || (isOwner(resource.data.userId) && request.resource.data.userId == request.auth.uid);
    }

    match /users/{userId} {
      allow read: if isAdmin() || isOwner(userId);

      allow create: if isOwner(userId)
        && request.resource.data.role == 'customer';

      allow update: if isOwner(userId)
        && (
          request.resource.data.role == resource.data.role
          || (
            resource.data.role == null
            && request.resource.data.role == 'customer'
          )
        );

      allow delete: if false;
    }

    match /products/{productId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /inventory/{productId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /stock_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }
  }
}
