rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- HELPERS ---
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && (
          request.auth.token.admin == true
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        );
    }

    // New Helper: Checks if the user has the 'driver' role in the database
    function isDriver() {
      return isSignedIn() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'driver';
    }

    function isOwnerRole() {
      return isSignedIn()
        && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'owner'
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Owner'
        );
    }

    function isOwner(ownerId) {
      return isSignedIn() && request.auth.uid == ownerId;
    }

    function isAdminOrOwner(ownerId) {
      return isAdmin() || isOwner(ownerId);
    }

    // --- COLLECTIONS ---

    match /orders/{orderId} {
      // Drivers need to see all orders to know what to deliver
      allow read: if isAdmin() || isOwnerRole() || isAdminOrOwner(resource.data.userId) || isDriver();

      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasAll(['userId', 'items', 'total', 'status', 'createdAt', 'customerName', 'customerEmail'])
        && request.resource.data.userId is string
        && request.resource.data.items is list
        && request.resource.data.total is number
        && request.resource.data.status is string
        && request.resource.data.createdAt is timestamp
        && request.resource.data.customerName is string
        && request.resource.data.customerEmail is string;

      // Allow drivers to update orders (specifically to mark them as confirmed)
      allow update: if isAdmin() || isDriver() || (isOwner(resource.data.userId) && request.resource.data.userId == request.auth.uid);
      
      allow delete: if isAdmin();
    }

    match /proofs/{proofId} {
      allow read: if isAdmin() || isDriver();
      allow create, update: if isAdmin() || isDriver();
      allow delete: if isAdmin();
    }

    match /users/{userId} {
      // Drivers need to read customer documents to see delivery addresses
      allow read: if isAdmin() || isOwner(userId) || isDriver();

      allow create: if (isOwner(userId)
        && request.resource.data.role == 'customer')
        || (isAdmin()
        && request.resource.data.role == 'driver'
        && request.resource.data.keys().hasAll(['fullName', 'email', 'contactNumber', 'role']));

      allow update: if isOwner(userId)
        && (
          request.resource.data.role == resource.data.role
          || (
            resource.data.role == null
            && request.resource.data.role == 'customer'
          )
        );

      allow delete: if isAdmin() && resource.data.role == 'driver';
    }

    match /products/{productId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /inventory/{productId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /daily_analytics/{dateKey} {
      allow read: if isAdmin() || isOwnerRole();
      allow create, update, delete: if isAdmin();
    }

    match /stock_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }
  }
}